# Configuracoes do ambiente — nunca inserir senhas ou chaves reais no repositorio
META_FEITA_ENV=development
META_FEITA_HOST=0.0.0.0
META_FEITA_PORT=8000

# Banco: SQLite por padrao. Defina DATABASE_URL para usar PostgreSQL.
META_FEITA_DATABASE_PATH=./meta_feita_monetization.db
META_FEITA_DATABASE_URL=

META_FEITA_CATALOG_PATH=./catalog.json
META_FEITA_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Limite de requisicoes por IP. PROXY_HOPS = quantos proxies confiaveis acrescentam o IP
# ao final de X-Forwarded-For (0 ignora o cabecalho). No Render, comece com 1 e confirme
# nos logs do primeiro deploy.
META_FEITA_RATE_LIMIT_ENABLED=true
META_FEITA_RATE_LIMIT_PROXY_HOPS=0

# Segredos externos (preencher apenas em runtime/producao fora do Git)
META_FEITA_WEB_WEBHOOK_SECRET=

# Google Play: disabled | sandbox (nunca em producao) | google_play
META_FEITA_PLAY_VALIDATION_MODE=disabled
META_FEITA_PLAY_PACKAGE_NAME=com.feitolabs.meta_feita
# Caminho do JSON da conta de servico ou o proprio conteudo JSON em uma linha.
META_FEITA_GOOGLE_APPLICATION_CREDENTIALS=

# AdMob SSV: IDs numericos dos blocos premiados aceitos (parte apos a "/"), separados por virgula.
META_FEITA_ADMOB_REWARDED_AD_UNITS=
# Usado apenas pelo endpoint interno /v1/ads/rewarded/claim. Em producao, deixe vazio.
META_FEITA_ADMOB_SSV_SECRET=
